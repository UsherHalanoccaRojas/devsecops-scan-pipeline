# Variables de entorno para la aplicación
# Copia este archivo como .env y complétalo con tus valores reales
# NUNCA commitear el archivo .env real al repositorio

# Puerto del servidor
PORT=3000

# Base de datos
DB_PATH=./data/users.db

# JWT - Usar un secreto fuerte en producción
JWT_SECRET=reemplaza_con_un_secreto_fuerte_y_aleatorio

# APIs externas (ejemplos - reemplazar con valores reales desde tu proveedor)
STRIPE_API_KEY=sk_live_tu_clave_aqui
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_key

# Entorno
NODE_ENV=production
